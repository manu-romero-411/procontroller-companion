[Unit]
Description=Pro Controller companion daemon (screenshot map + Home double-press launcher)
After=systemd-udevd.service bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/procontroller-companion
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
